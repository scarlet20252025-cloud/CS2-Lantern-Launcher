<Window x:Class="Lantern.App.TerminalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lantern · 游戏终端" Icon="Assets/lantern.ico" Width="1000" Height="960" MinWidth="880" MinHeight="760" Background="#0D1522" Foreground="#E8ECF2" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style x:Key="Section" TargetType="Border"><Setter Property="Background" Value="#172233"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#FFBF79"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#A3B1C4"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#C6D3E4"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0"/></Style>
  <Style x:Key="Wide" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Width" Value="64"/><Setter Property="Margin" Value="0"/><Setter Property="TextAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="320"/><RowDefinition Height="10"/><RowDefinition Height="2*" MinHeight="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="管道" VerticalAlignment="Center" Foreground="#8E9CAE"/><TextBox x:Name="PortInput" Text="自动" Width="330" Margin="8,0,12,0" FontFamily="Consolas" FontSize="11" ToolTip="启动器自己拉起服务器时创建的命名管道；命令从这里下发，回显从该进程 stdout 读取。"/><Button x:Name="ConnectButton" Content="连接游戏" Click="ConnectClick"/><Button Content="断开" Click="DisconnectClick" Margin="0"/></StackPanel><StackPanel><TextBlock Text="游戏终端" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionText" Text="未连接 · 自动识别目标进程与终端管道" Foreground="#FFBF79" Margin="0,6,0,0"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1">
   <Border x:Name="RepairPanel" Background="#493522" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="本机边玩边开模式无法启用终端。CS2 已移除终端端口；新通道要求回显从启动器自己拉起的进程读取，而 Steam 启动的客户端不提供。" TextWrapping="Wrap" Foreground="#FFCF98"/><Button x:Name="RepairButton" Content="改用独立服务器…" Click="EnableTerminalClick" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="点击后查看说明；不会结束当前游戏，也不会切换地图。独立服务器模式下换图、人数与人机管理都可用。" TextWrapping="Wrap" Foreground="#C8B9A8" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
   <Border x:Name="CapacityPanel" Background="#14303F" BorderBrush="#2C5872" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"><DockPanel>
    <Button x:Name="RaiseCapButton" DockPanel.Dock="Right" Content="提高上限并重启…" Click="RaiseCapClick" Background="#725030" Padding="16,8" MinHeight="34" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
    <StackPanel x:Name="CapRow" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"><TextBlock Text="新上限" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CapInput" Style="{StaticResource Number}" Width="58" MaxLength="2" ToolTip="人数上限只接受 2–64。改完必须重启服务器才会生效。"/></StackPanel>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="CapacityText" Text="人数上限：未连接" Foreground="#BFDDF2" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="CapacityHint" Text="连接服务器后显示该进程的启动上限。" Foreground="#93B4C9" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
   </DockPanel></Border>
   <Border Background="#25372E" CornerRadius="8" Padding="12" Margin="0,0,0,10"><TextBlock x:Name="ActionState" Text="选择快捷操作，或在下方输入命令" Foreground="#C0E4CB" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
  </StackPanel>
  <Grid Grid.Row="2">
  <TabControl x:Name="CommandTabs"><TabItem Header="人机管理"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"><StackPanel Margin="4,10,4,34">
    <TextBlock Text="按队伍增加人机" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="逐个核验指定队伍；满员即停，不转加另一队。单队容量仍受模式和出生点限制。" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
    <Border Style="{StaticResource Section}"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="增加到 T 方" Foreground="#DCE6F3" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="人数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AddTCount" Text="1" MaxLength="2" Style="{StaticResource Number}" ToolTip="向 T 增加的人数，1–32"/></StackPanel>
      <Button Content="T + 自定义人数" Tag="t" Click="AddTeamClick" Style="{StaticResource Wide}"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="增加到 CT 方" Foreground="#DCE6F3" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="人数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AddCtCount" Text="1" MaxLength="2" Style="{StaticResource Number}" ToolTip="向 CT 增加的人数，1–32"/></StackPanel>
      <Button Content="CT + 自定义人数" Tag="ct" Click="AddTeamClick" Style="{StaticResource Wide}"/>
     </StackPanel>
    </Grid></Border>
    <Border Style="{StaticResource Section}"><StackPanel>
     <TextBlock Text="按真人阵容补位" Style="{StaticResource SectionTitle}"/>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="每队目标" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TeamTarget" Width="180" SelectedIndex="0" SelectionChanged="TargetChanged" Margin="0" VerticalContentAlignment="Center"><ComboBoxItem Content="按较多的一队补齐" Tag="0"/><ComboBoxItem Content="5 v 5" Tag="5"/><ComboBoxItem Content="6 v 6" Tag="6"/><ComboBoxItem Content="7 v 7" Tag="7"/><ComboBoxItem Content="10 v 10" Tag="10"/></ComboBox></StackPanel>
     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="T 真人" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumansT" Grid.Column="1" Tag="3" Style="{StaticResource Number}" Margin="0,0,18,0" TextChanged="TeamCountsChanged"/>
      <TextBlock Text="CT 真人" Grid.Column="2" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HumansCt" Grid.Column="3" Tag="4" Style="{StaticResource Number}" TextChanged="TeamCountsChanged"/>
     </Grid>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="TeamFillButton" Content="一键补齐" Click="TeamFillClick" Background="#725030" Style="{StaticResource Action}" Padding="22,10"/><TextBlock x:Name="TeamPreview" Foreground="#FFBF79" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
     <TextBlock Text="请填记分板的两队真人人数；清除旧人机后按指定队伍补齐，不移动真人。人数变化后重新执行。" Style="{StaticResource Caption}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Section}"><StackPanel>
     <TextBlock Text="总人数与难度" Style="{StaticResource SectionTitle}"/>
     <WrapPanel Margin="0,8,0,0"><TextBlock Text="总人数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BalanceTotal" Text="10" Style="{StaticResource Number}" Margin="0,0,12,0"/><Button Content="持续填充" ToolTip="真人加入时自动减少人机；按总人数填充，开启队伍平衡" Click="BalanceClick" Style="{StaticResource Action}"/><Button Content="清除人机" Click="RemoveBotsClick" Style="{StaticResource Action}" Margin="8,0,0,0"/></WrapPanel>
     <WrapPanel Margin="0,12,0,0"><TextBlock Text="人机难度" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="QuickDifficulty" SelectedIndex="2" Width="120" Margin="0,0,12,0"><ComboBoxItem Content="简单"/><ComboBoxItem Content="普通"/><ComboBoxItem Content="困难"/><ComboBoxItem Content="专家"/></ComboBox><Button Content="应用难度" Click="DifficultyClick" Style="{StaticResource Action}"/></WrapPanel>
     <TextBlock Text="持续填充与清除人机都会立即改动对局；核实结果以终端输出为准。" Style="{StaticResource Caption}"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem><TabItem Header="对局控制"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"><StackPanel Margin="4,10,4,34">
    <TextBlock Text="对局流程" Style="{StaticResource SectionTitle}"/>
    <Border Style="{StaticResource Section}"><UniformGrid Columns="2">
     <Button Content="重开对局" Click="RestartClick" Margin="0,0,8,8" Padding="16,12" MinHeight="42"/>
     <Button Content="交换阵营" ToolTip="交换双方并重开对局" Tag="mp_swapteams" Click="QuickClick" Margin="0,0,0,8" Padding="16,12" MinHeight="42"/>
     <Button Content="开始热身" Tag="mp_warmup_start" Click="QuickClick" Margin="0,0,8,8" Padding="16,12" MinHeight="42"/>
     <Button Content="结束热身" Tag="mp_warmup_end" Click="QuickClick" Margin="0,0,0,8" Padding="16,12" MinHeight="42"/>
     <Button Content="暂停对局" Tag="mp_pause_match" ToolTip="通常在下个冻结时间暂停" Click="QuickClick" Margin="0,0,8,0" Padding="16,12" MinHeight="42"/>
     <Button Content="继续对局" Tag="mp_unpause_match" Click="QuickClick" Margin="0" Padding="16,12" MinHeight="42"/>
    </UniformGrid></Border>
    <TextBlock Text="这些操作直接作用于当前对局，不会重载地图。" Style="{StaticResource Caption}"/>
   </StackPanel></ScrollViewer></TabItem><TabItem Header="武器装备"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"><StackPanel x:Name="WeaponsPanel" Margin="4,12,4,34"/></ScrollViewer></TabItem><TabItem Header="经济购买"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"><StackPanel x:Name="EconomyPanel" Margin="4,12,4,34"/></ScrollViewer></TabItem><TabItem Header="练习辅助"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"><StackPanel x:Name="PracticePanel" Margin="4,12,4,34"/></ScrollViewer></TabItem><TabItem Header="信息 / 日志"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"><StackPanel Margin="4,10,4,34">
    <TextBlock Text="查询与导出" Style="{StaticResource SectionTitle}"/>
    <Border Style="{StaticResource Section}"><UniformGrid Columns="2">
     <Button Content="服务器状态" Click="StatusClick" Margin="0,0,8,8" Padding="16,12" MinHeight="42"/>
     <Button Content="人机与规则" ToolTip="bot_quota / bot_quota_mode / bot_difficulty / mp_autoteambalance / mp_limitteams" Tag="bot_quota; bot_quota_mode; bot_difficulty; mp_autoteambalance; mp_limitteams" Click="QuickClick" Margin="0,0,0,8" Padding="16,12" MinHeight="42"/>
     <Button Content="导出日志" Click="ExportClick" Margin="0,0,8,0" Padding="16,12" MinHeight="42"/>
     <Button Content="清空显示" Click="ClearClick" Margin="0" Padding="16,12" MinHeight="42"/>
    </UniformGrid></Border>
   </StackPanel></ScrollViewer></TabItem></TabControl>
  <Rectangle Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False">
   <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000A121D" Offset="0"/><GradientStop Color="#990A121D" Offset="0.55"/><GradientStop Color="#F20A121D" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
  </Rectangle>
  </Grid>
  <GridSplitter Grid.Row="3" Height="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ToolTip="上下拖动，调整操作区与日志的高度"/>
  <TextBox Grid.Row="4" x:Name="LogBox" MinHeight="90" VerticalContentAlignment="Top" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#080F19" Margin="0"/>
  <DockPanel Grid.Row="5" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="发送 ↵" Click="SendClick" Margin="12,0,0,0"/><TextBox x:Name="CommandInput" Tag="输入 CS2 命令，例如 status；↑ ↓ 浏览历史" Margin="0" KeyDown="InputKeyDown"/></DockPanel>
 </Grid>
</Window>
