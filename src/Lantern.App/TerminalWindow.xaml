<Window x:Class="Lantern.App.TerminalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lantern · 游戏终端" Icon="Assets/lantern.ico" Width="980" Height="900" MinWidth="850" MinHeight="820" Background="#0D1522" Foreground="#E8ECF2" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="管道" VerticalAlignment="Center" Foreground="#8E9CAE"/><TextBox x:Name="PortInput" Text="自动" Width="300" Margin="8,0,12,0" FontFamily="Consolas" FontSize="11"/><Button x:Name="ConnectButton" Content="连接游戏" Click="ConnectClick"/><Button Content="断开" Click="DisconnectClick"/></StackPanel><StackPanel><TextBlock Text="游戏终端" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionText" Text="未连接 · 自动识别目标进程与终端管道" Foreground="#FFBF79" Margin="0,6,0,0"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1">
   <Border x:Name="RepairPanel" Background="#493522" CornerRadius="8" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="外部终端必须随游戏启动启用。连接按钮不会重启游戏。" TextWrapping="Wrap" Foreground="#FFCF98"/><Button x:Name="RepairButton" Content="启用终端并重新启动 CS2…" Click="EnableTerminalClick" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="结束当前游戏，进入所选地图；点击后需要确认。私服模式不用于官方匹配。" TextWrapping="Wrap" Foreground="#C8B9A8" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="#25372E" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="ActionState" Text="选择快捷操作，或在下方输入命令" Foreground="#C0E4CB" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
   <TabControl x:Name="CommandTabs" Margin="0,0,0,12" Height="340"><TabItem Header="人机管理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="按队伍增加人机" FontSize="15" FontWeight="SemiBold" Foreground="#FFBF79" Margin="0,12,0,8"/>
   <WrapPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,20,8"><TextBlock Text="T +" VerticalAlignment="Center"/><TextBox x:Name="AddTCount" Text="1" Width="58" MaxLength="2" Margin="8,0" ToolTip="向 T 增加的人数，1–32"/><Button Content="T + 自定义人数" Tag="t" Click="AddTeamClick" Margin="0"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="CT +" VerticalAlignment="Center"/><TextBox x:Name="AddCtCount" Text="1" Width="58" MaxLength="2" Margin="8,0" ToolTip="向 CT 增加的人数，1–32"/><Button Content="CT + 自定义人数" Tag="ct" Click="AddTeamClick" Margin="0"/></StackPanel>
   </WrapPanel>
   <TextBlock Text="逐个核验指定队伍；满员即停，不转加另一队。单队容量仍受模式和出生点限制。" Foreground="#A3B1C4" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
   <Border Background="#172233" CornerRadius="9" Padding="14" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="按真人阵容补位" FontSize="16" FontWeight="SemiBold" Foreground="#FFBF79"/>
    <WrapPanel Margin="0,10,0,0"><TextBlock Text="每队目标" VerticalAlignment="Center"/><ComboBox x:Name="TeamTarget" Width="165" SelectedIndex="0" SelectionChanged="TargetChanged" Margin="10,0,0,0"><ComboBoxItem Content="按较多的一队补齐" Tag="0"/><ComboBoxItem Content="5 v 5" Tag="5"/><ComboBoxItem Content="6 v 6" Tag="6"/><ComboBoxItem Content="7 v 7" Tag="7"/><ComboBoxItem Content="10 v 10" Tag="10"/></ComboBox></WrapPanel>
    <WrapPanel Margin="0,12,0,0"><TextBlock Text="T 真人" VerticalAlignment="Center"/><TextBox x:Name="HumansT" Tag="3" Width="54" Margin="8,0,16,0" TextChanged="TeamCountsChanged"/><TextBlock Text="CT 真人" VerticalAlignment="Center"/><TextBox x:Name="HumansCt" Tag="4" Width="54" Margin="8,0,16,0" TextChanged="TeamCountsChanged"/><Button x:Name="TeamFillButton" Content="一键补齐" Click="TeamFillClick" Background="#725030"/><TextBlock x:Name="TeamPreview" VerticalAlignment="Center" Foreground="#FFBF79"/></WrapPanel>
    <TextBlock Text="请填记分板的两队真人人数；清除旧人机后按指定队伍补齐，不移动真人。人数变化后重新执行。" TextWrapping="Wrap" Foreground="#A3B1C4" FontSize="11" Margin="0,10,0,0"/>
   </StackPanel></Border>
<WrapPanel Margin="0,10,0,0">
    <TextBlock Text="总人数" VerticalAlignment="Center"/><TextBox x:Name="BalanceTotal" Text="10" Width="54" Margin="8,0,10,0"/><Button Content="持续填充" ToolTip="真人加入时自动减少人机；按总人数填充，开启队伍平衡" Click="BalanceClick"/>
    <Button Content="清除人机" Click="RemoveBotsClick"/>
   </WrapPanel>
   <WrapPanel>
    <ComboBox x:Name="QuickDifficulty" SelectedIndex="2" Width="94" Margin="0"><ComboBoxItem Content="简单"/><ComboBoxItem Content="普通"/><ComboBoxItem Content="困难"/><ComboBoxItem Content="专家"/></ComboBox><Button Content="应用难度" Click="DifficultyClick" Margin="8,0,0,0"/>
   </WrapPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="对局控制"><WrapPanel Margin="0,10,0,0">
    <Button Content="重开对局" Click="RestartClick"/><Button Content="结束热身" Tag="mp_warmup_end" Click="QuickClick"/><Button Content="开始热身" Tag="mp_warmup_start" Click="QuickClick"/><Button Content="暂停对局" Tag="mp_pause_match" ToolTip="通常在下个冻结时间暂停" Click="QuickClick"/><Button Content="继续对局" Tag="mp_unpause_match" Click="QuickClick"/><Button Content="交换阵营" ToolTip="交换双方并重开对局" Tag="mp_swapteams" Click="QuickClick"/>
   </WrapPanel></TabItem><TabItem Header="武器装备"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="WeaponsPanel" Margin="4,12,4,8"/></ScrollViewer></TabItem><TabItem Header="经济购买"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="EconomyPanel" Margin="4,12,4,8"/></ScrollViewer></TabItem><TabItem Header="练习辅助"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PracticePanel" Margin="4,12,4,8"/></ScrollViewer></TabItem><TabItem Header="信息 / 日志"><WrapPanel Margin="0,10,0,0"><Button Content="服务器状态" Click="StatusClick"/><Button Content="人机与规则" Tag="bot_quota; bot_quota_mode; bot_difficulty; mp_autoteambalance; mp_limitteams" Click="QuickClick"/><Button Content="导出日志" Click="ExportClick"/><Button Content="清空显示" Click="ClearClick"/></WrapPanel></TabItem></TabControl>
  </StackPanel>
  <TextBox Grid.Row="2" x:Name="LogBox" VerticalContentAlignment="Top" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#080F19" Margin="0"/>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="发送 ↵" Click="SendClick" Margin="12,0,0,0"/><TextBox x:Name="CommandInput" Tag="输入 CS2 命令，例如 status；↑ ↓ 浏览历史" Margin="0" KeyDown="InputKeyDown"/></DockPanel>
  <TextBlock Grid.Row="4" Text="自动读取目标进程的终端端口；未启用时不会重启游戏。连接会先用 echo 回显确认；发送成功不代表命令权限／游戏规则允许，结果以终端输出为准。" TextWrapping="Wrap" Foreground="#8E9CAE" FontSize="11" Margin="0,12,0,0"/>
 </Grid>
</Window>
